app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Widget Preview related
.widget_preview/

# FVM: the pinned SDK version lives in .fvmrc; the local SDK link is per machine
.fvm/

# Claude Code personal settings
.claude/settings.local.json

# Reference clips for manual checks; too big to commit and never bundled
assets/videos/

# Signing keys never go in the repo: it is public (spec §9 Signing).
*.jks
*.keystore
key.properties
*.p12
*.mobileprovision
